# ============================================================
#  Copy to .env  (cp .env.example .env)  — NEVER commit .env
# ============================================================

# --- LLM: FREE APIs ONLY (competition rule — paid APIs disqualify the team) -------
# Default: Google Gemini free tier. Key: https://aistudio.google.com/apikey
#   Do NOT enable billing on that Google project, so it stays on the free tier.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# gemini-2.5-* are closed to new keys; run `make check` to list the models your key can use.
# Fallbacks on the same provider (each Gemini model has its own free rate limit)
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Query rewrite + translation + eval judge
LLM_UTILITY_MODEL=gemini-3.5-flash-lite
# Optional second FREE provider for those helper calls, to spread rate limits, e.g. Groq free tier:
#   UTILITY_BASE_URL=https://api.groq.com/openai/v1   UTILITY_API_KEY=gsk_...   LLM_UTILITY_MODEL=llama-3.1-8b-instant
UTILITY_BASE_URL=
UTILITY_API_KEY=
# Seconds before switching to the next fallback model
LLM_TIMEOUT=20
# Thinking budget for reasoning models (Gemini 3.x): low = fast. Empty = provider default.
LLM_REASONING_EFFORT=low
# Blocks paid models (e.g. OpenRouter models without ":free"). Keep true.
FREE_ONLY=true
# Cost tracking: 0 on free tiers. For the business plan, model the PAID price with `make cost` flags instead.
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
# true = offline extractive answers (emergency demo mode, no internet needed for the LLM)
LLM_MOCK=false

# --- Arabic-first knowledge base ---
# ar = translate English (non-Arabic) pages to Arabic at ingestion. Cached in backend/data/translations,
# so `make reset` does not pay again. Leave empty to keep documents in their original language.
TRANSLATE_DOCS_TO=
TRANSLATION_MODEL=
TRANSLATION_WORKERS=6

# --- Embeddings ---
# fastembed (local, free, private)  |  openrouter (remote)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Faster/smaller alternative: sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- Chunking / retrieval (tune, then re-run `make eval`) ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
CANDIDATE_K=20
HYBRID_ALPHA=0.5
USE_RERANKER=true
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
USE_QUERY_REWRITE=true
MIN_RELEVANCE_SCORE=0.15

# --- Auth / security ---
JWT_SECRET=please-generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ALLOW_ANONYMOUS_CHAT=true
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=
APP_TITLE=RAG Hackathon
