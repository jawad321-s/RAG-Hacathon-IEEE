# ============================================================
#  Copy to .env  (cp .env.example .env)  — NEVER commit .env
# ============================================================

# --- LLM: any OpenAI-compatible API ---------------------------------------
# Default: OpenRouter (https://openrouter.ai/keys).
# FREE options (rate-limited; fine for development, risky for the live demo):
#   OpenRouter free models: keep this base URL, use model ids ending in ":free"
#   Google Gemini (aistudio.google.com/apikey):
#     OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-2.5-flash   LLM_UTILITY_MODEL=gemini-2.5-flash-lite   LLM_FALLBACK_MODELS=
#   Groq (console.groq.com/keys):
#     OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile   LLM_UTILITY_MODEL=llama-3.1-8b-instant   LLM_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional: a SEPARATE provider for helper calls (query rewrite, translation, eval judge).
# Example: answers on free Gemini, helpers on paid OpenRouter:
#   UTILITY_BASE_URL=https://openrouter.ai/api/v1   UTILITY_API_KEY=sk-or-...   LLM_UTILITY_MODEL=openai/gpt-4.1-mini
UTILITY_BASE_URL=
UTILITY_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
LLM_FALLBACK_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct
LLM_UTILITY_MODEL=openai/gpt-4.1-mini
# USD per 1M tokens of LLM_MODEL (copy from the model page) -> cost tracking & business plan
LLM_PRICE_INPUT_PER_M=0.40
LLM_PRICE_OUTPUT_PER_M=1.60
# true = offline extractive answers (emergency demo mode, no internet needed for the LLM)
LLM_MOCK=false

# --- Arabic-first knowledge base ---
# ar = translate English (non-Arabic) pages to Arabic at ingestion. Cached in backend/data/translations,
# so `make reset` does not pay again. Leave empty to keep documents in their original language.
TRANSLATE_DOCS_TO=
TRANSLATION_MODEL=
TRANSLATION_WORKERS=6

# --- Embeddings ---
# fastembed (local, free, private)  |  openrouter (remote)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Faster/smaller alternative: sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- Chunking / retrieval (tune, then re-run `make eval`) ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
CANDIDATE_K=20
HYBRID_ALPHA=0.5
USE_RERANKER=true
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
USE_QUERY_REWRITE=true
MIN_RELEVANCE_SCORE=0.15

# --- Auth / security ---
JWT_SECRET=please-generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ALLOW_ANONYMOUS_CHAT=true
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=
APP_TITLE=RAG Hackathon
